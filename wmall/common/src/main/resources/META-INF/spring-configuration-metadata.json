{
  "groups": [
    {
      "name": "app.db"
    },
    {
      "name": "app.jwt",
      "type": "com.wei.mall.config.SecurityConfig",
      "sourceType": "com.wei.mall.config.JwtProperties"
    },
    {
      "name": "app.auth",
      "type": "com.wei.mall.config.MvcConfig",
      "sourceType": "com.wei.mall.config.AuthProperties"
    }
  ],
  "properties": [
    {
      "name": "app.mq.host",
      "type": "java.lang.String",
      "description": "rabbitmq的地址",
      "defaultValue": "192.168.150.101"
    },
    {
      "name": "app.mq.port",
      "type": "java.lang.Integer",
      "description": "rabbitmq的端口",
      "defaultValue": "5672"
    },
    {
      "name": "app.mq.vhost",
      "type": "java.lang.String",
      "description": "rabbitmq的virtual-host地址",
      "defaultValue": "/hmxt"
    },
    {
      "name": "app.mq.username",
      "type": "java.lang.String",
      "description": "rabbitmq的用户名",
      "defaultValue": "hmxt"
    },
    {
      "name": "app.mq.password",
      "type": "java.lang.String",
      "description": "rabbitmq的密码",
      "defaultValue": "123321"
    },
    {
      "name": "app.mq.listener.retry.enable",
      "type": "java.lang.Boolean",
      "description": "是否开启rabbitmq的消费者重试机制",
      "defaultValue": "true"
    },
    {
      "name": "app.mq.listener.retry.interval",
      "type": "java.time.Duration",
      "description": "消费者重试初始失败等待时长",
      "defaultValue": "1000ms"
    },
    {
      "name": "app.mq.listener.retry.multiplier",
      "type": "java.lang.Integer",
      "description": "失败等待时长的递增倍数",
      "defaultValue": "1"
    },
    {
      "name": "app.mq.listener.retry.max-attempts",
      "type": "java.lang.Integer",
      "description": "消费者重试最大重试次数",
      "defaultValue": "3"
    },
    {
      "name": "app.mq.listener.retry.stateless",
      "type": "java.lang.Boolean",
      "description": "是否是无状态，默认true",
      "defaultValue": "true"
    },
    {
      "name": "app.db.host",
      "type": "java.lang.String",
      "description": "数据库地址",
      "defaultValue": "127.0.0.1"
    },
    {
      "name": "app.db.port",
      "type": "java.lang.Integer",
      "description": "数据库端口",
      "defaultValue": "3306"
    },
    {
      "name": "app.db.database",
      "type": "java.lang.String",
      "description": "数据库database名",
      "defaultValue": ""
    },
    {
      "name": "app.db.username",
      "type": "java.lang.String",
      "description": "数据库用户名",
      "defaultValue": "root"
    },
    {
      "name": "app.db.password",
      "type": "java.lang.String",
      "description": "数据库密码",
      "defaultValue": "123456"
    },
    {
      "name": "app.jwt.location",
      "type": "java.lang.String",
      "description": "秘钥存储地址"
    },
    {
      "name": "app.jwt.alias",
      "type": "java.lang.String",
      "description": "秘钥别名"
    },
    {
      "name": "app.jwt.password",
      "type": "java.lang.String",
      "description": "秘钥文件密码"
    },
    {
      "name": "app.jwt.tokenTTL",
      "type": "java.time.Duration",
      "description": "登录有效期"
    },
    {
      "name": "app.auth.excludePaths",
      "type": "java.util.List",
      "description": "登录放行的路径"
    },
    {
      "name": "app.auth.includePaths",
      "type": "java.util.List",
      "description": "登录拦截的路径"
    }
  ],
  "hints": []
}