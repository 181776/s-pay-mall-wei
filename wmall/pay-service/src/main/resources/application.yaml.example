# 复制为 application-local.yaml 并填写真实值（不会提交 Git）

server:
  port: 8086

spring:
  application:
    name: pay-service
  config:
    import: optional:classpath:application-local.yaml
  cloud:
    nacos:
      server-addr: localhost:8848

app:
  db:
    host: 127.0.0.1
    port: 13306
    username: root
    password: your-mysql-password
    database: wmall-pay

# 支付宝沙箱：https://open.alipay.com/develop/sandbox/app
# notify_url 需填 natapp 公网域名，指向 Gateway 8080
alipay:
  app_id: your-alipay-app-id
  merchant_private_key: your-alipay-merchant-private-key
  alipay_public_key: your-alipay-public-key
  notify_url: http://your-natapp-domain/pay-orders/alipay/notify
  return_url: https://www.example.com
  gatewayUrl: https://openapi-sandbox.dl.alipaydev.com/gateway.do
  sign_type: RSA2
  charset: utf-8
  format: json
