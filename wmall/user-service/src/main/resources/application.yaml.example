# 复制为 application-local.yaml 并填写真实值（application-local.yaml 已在 .gitignore 中，不会提交）
# 或直接修改 application.yaml 中的占位符（不推荐提交真实密钥）

server:
  port: 8084

spring:
  application:
    name: user-service
  # 本地私密配置：同目录下 application-local.yaml 会覆盖本文件中的占位符
  config:
    import: optional:classpath:application-local.yaml
  cloud:
    nacos:
      server-addr: localhost:8848
  redis:
    host: localhost
    port: 16379
    # password: your-redis-password
    timeout: 3000ms

app:
  db:
    host: 127.0.0.1
    port: 13306
    username: root
    password: your-mysql-password
    database: wmall-user
  jwt:
    location: classpath:wmall.jks
    alias: wmall
    password: your-jks-password
    tokenTTL: 30m

weixin:
  config:
    originalid: your-weixin-original-id
    token: your-weixin-token
    app-id: your-weixin-app-id
    app-secret: your-weixin-app-secret
